---
interface Change {
  n: string;
  title: string;
  body: string;
}
interface Props {
  changes: Change[];
}
const { changes } = Astro.props;
---

<div class="changes">
  {
    changes.map((c) => (
      <div class="change-row rule-top" data-reveal>
        <p class="change-n">{c.n}</p>
        <div>
          <p class="change-title">{c.title}</p>
          <p class="change-body">{c.body}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .changes {
    max-width: var(--col-text);
  }
  .change-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 1.5rem 0;
  }
  .change-n {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--ink-soft);
    line-height: 1;
  }
  .change-title {
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
  }
  .change-body {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-mid);
    margin-top: 0.375rem;
    max-width: 60ch;
  }
</style>
