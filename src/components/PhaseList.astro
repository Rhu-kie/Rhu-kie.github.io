---
interface Phase {
  k: string;
  title: string;
  body: string;
}
interface Props {
  phases: Phase[];
}
const { phases } = Astro.props;
---

<div class="phases">
  {
    phases.map((p) => (
      <div class="phase-row rule-top" data-reveal>
        <p class="label phase-k">{p.k}</p>
        <div>
          <p class="phase-title">{p.title}</p>
          <p class="phase-body">{p.body}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .phase-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 1.5rem 0;
  }
  .phase-k {
    white-space: nowrap;
  }
  .phase-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: 1.375rem;
    color: var(--ink);
    line-height: 1.3;
  }
  .phase-body {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-mid);
    margin-top: 0.5rem;
    max-width: 60ch;
  }
</style>
