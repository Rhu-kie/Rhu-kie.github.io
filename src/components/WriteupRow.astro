---
interface Props {
  href: string;
  date: string;
  title: string;
  blurb: string;
}
const { href, date, title, blurb } = Astro.props;
---

<a href={href} class="writeup-row">
  <p class="label date">{date}</p>
  <div>
    <h3 class="writeup-title">{title}</h3>
    <p class="writeup-blurb">{blurb}</p>
  </div>
</a>

<style>
  .writeup-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 4vw, 3rem);
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--rule);
    padding: 1.75rem 0;
    transition: opacity var(--t-fast);
  }
  .writeup-row:hover {
    opacity: 0.62;
  }
  .date {
    white-space: nowrap;
  }
  .writeup-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.3;
  }
  .writeup-blurb {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-mid);
    margin-top: 0.5rem;
    max-width: 56ch;
  }

  @media (max-width: 520px) {
    .writeup-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
