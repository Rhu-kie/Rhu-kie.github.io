---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={`arrow ${className}`}
  width="14"
  height="14"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M5 12h14M12 5l7 7-7 7"></path>
</svg>

<style>
  .arrow {
    display: inline-block;
    transition: transform var(--t-fast);
  }
</style>
